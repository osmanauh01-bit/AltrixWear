{% doc %}
  @prompt
    Fix the homepage so links stop redirecting to the About page. There are two sections to repair. First, the category cards section showing "MEN'S ACTIVEWEAR", "WOMEN'S ACTIVEWEAR", and "SHAPEWEAR" cards with "EXPLORE COLLECTION →" links: each card must link to its own collection instead of the About page, with each card's destination set as a configurable collection picker so it can be updated per card. Use the existing collections Men's (collections/482829009132), Womens's (collections/482829074668), and Shapewear (collections/478580277484) as the current destinations. Keep the existing card visuals and hover behavior. Second, the "BEST SELLERS" section (with "PROVEN ESSENTIALS" heading and SALE-badged product cards): its product cards currently link to the About page and must instead link to each product's own product page, and the section's collection selector needs to pick the products shown. Do not change the section styling.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-homepage-featured-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-homepage-featured-{{ ai_gen_id }}__categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category {
    position: relative;
    min-height: {{ block.settings.category_height }}px;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    color: {{ block.settings.card_text_color }};
    text-decoration: none;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-image,
  .ai-homepage-featured-{{ ai_gen_id }}__category-placeholder {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.category_height }}px;
    object-fit: cover;
    display: block;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-placeholder {
    background: {{ block.settings.card_background }};
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: .35;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, .72));
    pointer-events: none;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-content {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 24px;
    left: 24px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-title,
  .ai-homepage-featured-{{ ai_gen_id }}__category-link {
    color: {{ block.settings.card_text_color }};
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-title {
    margin: 0 0 8px;
    font-size: {{ block.settings.category_title_size }}px;
    letter-spacing: .08em;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-link {
    font-size: 12px;
    letter-spacing: .08em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category:hover .ai-homepage-featured-{{ ai_gen_id }}__category-image {
    transform: scale(1.04);
  }

  .ai-homepage-featured-{{ ai_gen_id }}__category-image {
    transition: transform .35s ease;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__best-sellers {
    margin-top: {{ block.settings.section_spacing }}px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    letter-spacing: .08em;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__products {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__product {
    position: relative;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__product-image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.15;
    object-fit: cover;
    background: {{ block.settings.image_background }};
  }

  .ai-homepage-featured-{{ ai_gen_id }}__product-info {
    padding-top: 12px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__product-title,
  .ai-homepage-featured-{{ ai_gen_id }}__product-price {
    margin: 0;
    font-size: 14px;
  }

  .ai-homepage-featured-{{ ai_gen_id }}__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 8px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: 11px;
    letter-spacing: .06em;
  }

  @media screen and (max-width: 749px) {
    .ai-homepage-featured-{{ ai_gen_id }}__categories,
    .ai-homepage-featured-{{ ai_gen_id }}__products {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-homepage-featured-{{ ai_gen_id }}__category:last-child {
      grid-column: span 2;
    }
  }
{% endstyle %}

<div class="ai-homepage-featured-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-homepage-featured-{{ ai_gen_id }}__categories">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'category_' | append: i | append: '_title'
        assign image_key = 'category_' | append: i | append: '_image'
        assign collection_key = 'category_' | append: i | append: '_collection'
        assign category_title = block.settings[title_key]
        assign category_image = block.settings[image_key]
        assign category_collection = block.settings[collection_key]
      %}
      {% if category_collection != blank %}
        <a class="ai-homepage-featured-{{ ai_gen_id }}__category" href="{{ category_collection.url }}">
          {% if category_image != blank %}
            <img class="ai-homepage-featured-{{ ai_gen_id }}__category-image" src="{{ category_image | image_url: width: 1200 }}" alt="{{ category_image.alt | default: category_title | escape }}" loading="lazy" width="{{ category_image.width }}" height="{{ category_image.height }}">
          {% else %}
            <div class="ai-homepage-featured-{{ ai_gen_id }}__category-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
          <span class="ai-homepage-featured-{{ ai_gen_id }}__category-content">
            <strong class="ai-homepage-featured-{{ ai_gen_id }}__category-title">{{ category_title }}</strong>
            <span class="ai-homepage-featured-{{ ai_gen_id }}__category-link">{{ block.settings.category_link_label }} →</span>
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.best_sellers_collection != blank %}
    <section class="ai-homepage-featured-{{ ai_gen_id }}__best-sellers" aria-labelledby="ai-homepage-featured-heading-{{ ai_gen_id }}">
      <h2 id="ai-homepage-featured-heading-{{ ai_gen_id }}" class="ai-homepage-featured-{{ ai_gen_id }}__heading">{{ block.settings.best_sellers_heading }}</h2>
      <div class="ai-homepage-featured-{{ ai_gen_id }}__products">
        {% for product in block.settings.best_sellers_collection.products limit: block.settings.product_limit %}
          <a class="ai-homepage-featured-{{ ai_gen_id }}__product" href="{{ product.url }}">
            {% if product.compare_at_price > product.price %}<span class="ai-homepage-featured-{{ ai_gen_id }}__badge">{{ block.settings.sale_label }}</span>{% endif %}
            {% if product.featured_image %}<img class="ai-homepage-featured-{{ ai_gen_id }}__product-image" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% endif %}
            <span class="ai-homepage-featured-{{ ai_gen_id }}__product-info"><span class="ai-homepage-featured-{{ ai_gen_id }}__product-title">{{ product.title }}</span><span class="ai-homepage-featured-{{ ai_gen_id }}__product-price">{{ product.price | money }}</span></span>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>

{% schema %}
{
  "name": "Homepage collections",
  "settings": [
    {"type":"header","content":"Category cards"},
    {"type":"text","id":"category_1_title","label":"Card 1 title","default":"MEN'S ACTIVEWEAR"},
    {"type":"image_picker","id":"category_1_image","label":"Card 1 image"},
    {"type":"collection","id":"category_1_collection","label":"Card 1 collection"},
    {"type":"text","id":"category_2_title","label":"Card 2 title","default":"WOMEN'S ACTIVEWEAR"},
    {"type":"image_picker","id":"category_2_image","label":"Card 2 image"},
    {"type":"collection","id":"category_2_collection","label":"Card 2 collection"},
    {"type":"text","id":"category_3_title","label":"Card 3 title","default":"SHAPEWEAR"},
    {"type":"image_picker","id":"category_3_image","label":"Card 3 image"},
    {"type":"collection","id":"category_3_collection","label":"Card 3 collection"},
    {"type":"text","id":"category_link_label","label":"Link label","default":"EXPLORE COLLECTION"},
    {"type":"header","content":"Best sellers"},
    {"type":"text","id":"best_sellers_heading","label":"Heading","default":"PROVEN ESSENTIALS"},
    {"type":"collection","id":"best_sellers_collection","label":"Product collection"},
    {"type":"range","id":"product_limit","label":"Products shown","min":2,"max":12,"step":1,"default":4},
    {"type":"text","id":"sale_label","label":"Sale label","default":"SALE"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"category_height","label":"Card height","min":240,"max":700,"step":20,"unit":"px","default":420},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":16},
    {"type":"range","id":"section_spacing","label":"Section spacing","min":24,"max":120,"step":8,"unit":"px","default":64},
    {"type":"range","id":"category_title_size","label":"Card title size","min":12,"max":32,"step":2,"unit":"px","default":18},
    {"type":"range","id":"heading_size","label":"Heading size","min":16,"max":48,"step":2,"unit":"px","default":28},
    {"type":"color","id":"card_background","label":"Card background","default":"#222222"},
    {"type":"color","id":"card_text_color","label":"Card text","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text","default":"#111111"},
    {"type":"color","id":"image_background","label":"Image background","default":"#F7F7F7"},
    {"type":"color","id":"badge_background","label":"Badge background","default":"#111111"},
    {"type":"color","id":"badge_text_color","label":"Badge text","default":"#FFFFFF"}
  ],
  "presets": [{"name":"Homepage collections"}],
  "tag": null,
  "class": "homepage-collections-block"
}
{% endschema %}