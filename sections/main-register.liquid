<div class="account-section">
  <div class="page-container">
    <div class="account-wrapper">
      <div class="account-header">
        <span class="eyebrow">{{ 'customer.register.title' | default: 'Customer Portal' }}</span>
        <h1>CREATE ACCOUNT</h1>
        <p>{{ 'customer.register.subtext' | default: 'Join AltrixWear for faster checkout, order tracking, and private activewear drops.' }}</p>
      </div>

      <div class="account-card">
        <!-- Social Sign-Up Buttons -->
        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 6px;">
          <!-- Google One-Click Sign-Up -->
          <button type="button" class="btn-google" id="btn-google-register" aria-label="Sign up with Google">
            <svg width="18" height="18" viewBox="0 0 18 18">
              <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
              <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.173 0 7.549 0 9s.347 2.827.957 4.039l3.007-2.332z"/>
              <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
            </svg>
            Sign up with Google
          </button>
        </div>

        <div class="auth-divider"><span>OR REGISTER WITH EMAIL</span></div>

        {% form 'create_customer' %}
          {{ form.errors | default_errors }}

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="account-field-group">
              <label for="FirstName" class="account-label">{{ 'customer.register.first_name' | default: 'First Name' }}</label>
              <input
                type="text"
                name="customer[first_name]"
                id="FirstName"
                class="account-input"
                autocomplete="given-name"
                placeholder="First"
                required
              >
            </div>
            <div class="account-field-group">
              <label for="LastName" class="account-label">{{ 'customer.register.last_name' | default: 'Last Name' }}</label>
              <input
                type="text"
                name="customer[last_name]"
                id="LastName"
                class="account-input"
                autocomplete="family-name"
                placeholder="Last"
                required
              >
            </div>
          </div>

          <div class="account-field-group">
            <label for="CustomerEmail" class="account-label">{{ 'customer.register.email' | default: 'Email Address' }}</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              class="account-input"
              autocomplete="email"
              placeholder="name@example.com"
              required
            >
          </div>

          <div class="account-field-group">
            <label for="CustomerPassword" class="account-label">{{ 'customer.register.password' | default: 'Password' }}</label>
            <input
              type="password"
              name="customer[password]"
              id="CustomerPassword"
              class="account-input"
              autocomplete="new-password"
              placeholder="Minimum 6 characters"
              minlength="6"
              required
            >
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--space-md);">
            {{ 'customer.register.submit' | default: 'Create Account' }}
          </button>

          <div style="text-align: center; margin-top: var(--space-lg); font-size: 13px; color: var(--color-gray-dark);">
            <span>Already have an account?</span>
            <a href="{{ routes.account_login_url }}" style="font-weight: 700; color: var(--color-near-black); margin-left: 4px; text-decoration: underline;">
              Sign in
            </a>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
