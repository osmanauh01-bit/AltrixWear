<div class="account-section">
  <div class="page-container">
    <div class="account-wrapper">
      <div class="account-header">
        <span class="eyebrow">{{ 'customer.account.title' | default: 'Customer Portal' }}</span>
        <h1>{{ 'customer.login_page.title' | default: 'MY ACCOUNT' }}</h1>
        <p>{{ 'customer.login_page.subtext' | default: 'Sign in to view your orders, saved addresses, and activewear preferences.' }}</p>
      </div>

      <div class="account-card">
        <!-- Social Sign-In Buttons -->
        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 6px;">
          <!-- Google One-Click Sign-In -->
          <button type="button" class="btn-google" id="btn-google-signin" aria-label="Continue with Google">
            <svg width="18" height="18" viewBox="0 0 18 18">
              <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
              <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.173 0 7.549 0 9s.347 2.827.957 4.039l3.007-2.332z"/>
              <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
            </svg>
            Continue with Google
          </button>
        </div>

        <div class="auth-divider"><span>OR SIGN IN WITH EMAIL</span></div>

        {% form 'customer_login' %}
          {{ form.errors | default_errors }}

          <div class="account-field-group">
            <label for="CustomerEmail" class="account-label">{{ 'customer.login_page.email' | default: 'Email Address' }}</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              class="account-input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              placeholder="name@example.com"
            >
          </div>

          {% if form.password_needed %}
            <div class="account-field-group">
              <label for="CustomerPassword" class="account-label">{{ 'customer.login_page.password' | default: 'Password' }}</label>
              <div class="account-input-wrapper">
                <input
                  type="password"
                  name="customer[password]"
                  id="CustomerPassword"
                  class="account-input"
                  autocomplete="current-password"
                  required
                  placeholder="••••••••"
                >
              </div>
            </div>

            <div class="account-form-meta">
              <a href="#recover" id="RecoverPassword" class="account-forgot-link">
                {{ 'customer.login_page.forgot_password' | default: 'Forgot password?' }}
              </a>
            </div>
          {% endif %}

          <button type="submit" class="btn btn-primary btn-block">
            {{ 'customer.login_page.sign_in' | default: 'Sign In' }}
          </button>

          <div style="text-align: center; margin-top: var(--space-lg); font-size: 13px; color: var(--color-gray-dark);">
            <span>Don't have an account?</span>
            <a href="{{ routes.account_register_url }}" style="font-weight: 700; color: var(--color-near-black); margin-left: 4px; text-decoration: underline;">
              Create one
            </a>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Login",
  "settings": []
}
{% endschema %}
