<div class="section-spacing" style="padding-top: 130px;">
  <div class="page-container page-container-narrow">
    <div class="section-header text-left">
      <span class="eyebrow">Checkout Review</span>
      <h1>YOUR BAG (<span class="cart-count">{{ cart.item_count | default: 0 }}</span>)</h1>
      <p>Free standard US shipping on all orders over $75.</p>
    </div>

    {% if cart.item_count == 0 %}
      <div style="background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: 48px 24px; text-align: center; margin-bottom: var(--space-xl);">
        <div style="margin-bottom: 16px; color: var(--color-gray-dark); display: flex; justify-content: center;">
          {% render 'icon', name: 'cart' %}
        </div>
        <h3 style="font-size: 18px; font-weight: 800; text-transform: uppercase; margin-bottom: 8px;">Your Bag Is Empty</h3>
        <p style="font-size: 14px; color: var(--color-gray-dark); margin-bottom: 24px; max-width: 360px; margin-left: auto; margin-right: auto;">
          You don't have any items in your bag yet. Discover our performance activewear and supportive shapewear.
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="display: inline-block; padding: 14px 32px;">
          Explore All Products
        </a>
      </div>
    {% else %}
      <div style="background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-xl); margin-bottom: var(--space-xl);">
        {% for item in cart.items %}
          <div class="cart-item" {% if forloop.last %}style="border-bottom: none; padding-bottom: 0;"{% endif %}>
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="cart-item-img">
            <div class="cart-item-details">
              <h3 class="cart-item-title">{{ item.product.title }}</h3>
              <span class="cart-item-variant">{{ item.variant.title }}</span>
              <span class="cart-item-price">${{ item.final_line_price | money_without_trailing_zeros }}</span>
              <div class="cart-item-actions">
                <div class="qty-control">
                  <button type="button" class="qty-btn" data-change="dec">&minus;</button>
                  <input type="text" class="qty-input" value="{{ item.quantity }}" readonly>
                  <button type="button" class="qty-btn" data-change="inc">&plus;</button>
                </div>
                <button type="button" class="cart-remove-btn">Remove</button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Summary Box -->
      <div style="background: var(--color-off-white); border: 1px solid var(--color-border); border-radius: var(--radius-xs); padding: var(--space-xl);">
        <div class="cart-subtotal-row">
          <span>Subtotal</span>
          <span>${{ cart.total_price | money_without_trailing_zeros }}</span>
        </div>
        <p style="font-size: 13px; color: var(--color-gray-dark); margin-bottom: 20px;">
          Estimated US Delivery: <strong>8&ndash;12 business days</strong> &bull; Taxes and shipping calculated at checkout.
        </p>
        <a href="/checkout" class="btn btn-primary btn-block">
          CHECKOUT &bull; ${{ cart.total_price | money_without_trailing_zeros }}
        </a>
        <div style="text-align: center; margin-top: 14px;">
          <a href="/collections/all" style="font-size: 13px; text-decoration: underline; color: var(--color-gray-medium);">Continue Shopping</a>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
