<div class="section-spacing" style="padding-top: 130px;">
  <div class="page-container">
    <!-- Collection Editorial Header -->
    <div class="section-header text-left" style="margin-bottom: var(--space-xl);">
      <span class="eyebrow">Collection</span>
      <h1>{{ collection.title | default: 'All Activewear & Compression' }}</h1>
      <p>
        {{ collection.description | default: 'High-performance activewear, compression layers, and supportive contours engineered for training, movement, and everyday confidence.' }}
      </p>
    </div>

    <!-- Filter & Sort Bar -->
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-xl);">
      <div style="display: flex; gap: var(--space-sm); overflow-x: auto;">
        <a href="/collections/all" class="btn btn-sm {% if collection.handle == 'all' or collection.handle == blank %}btn-primary{% else %}btn-secondary{% endif %}" data-filter="all">All (10)</a>
        <a href="/collections/mens" class="btn btn-sm {% if collection.handle == 'mens' %}btn-primary{% else %}btn-secondary{% endif %}" data-filter="men">Men's (5)</a>
        <a href="/collections/womens" class="btn btn-sm {% if collection.handle == 'womens' %}btn-primary{% else %}btn-secondary{% endif %}" data-filter="women">Women's (5)</a>
        <a href="/collections/shapewear" class="btn btn-sm {% if collection.handle == 'shapewear' %}btn-primary{% else %}btn-secondary{% endif %}" data-filter="shapewear">Shapewear (4)</a>
      </div>

      <div style="font-size: 13px; font-weight: 600; color: var(--color-gray-dark);">
        <span id="collection-product-count">10 Items</span>
      </div>
    </div>

    <!-- Product Grid: 4-col desktop, 2-col mobile -->
    <div class="product-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        <!-- Product 1: Men -->
        <div class="product-card" data-category="men shapewear">
          <div class="product-card-media">
            <a href="/products/corealign-compression-vest">
              <img src="{{ 'prod-corealign-vest.jpg' | asset_url }}" alt="CoreAlign Compression Vest" class="product-card-img" loading="lazy" width="400" height="500">
            </a>
            <span class="product-card-badge">Sale</span>
            <div class="product-card-quickadd">
              <button type="button" class="btn btn-primary btn-sm btn-block" data-action="quick-add" data-product-title="CoreAlign Compression Vest">Quick Add</button>
            </div>
          </div>
          <div class="product-card-content">
            <span class="product-card-type">Men's Activewear</span>
            <h3 class="product-card-title"><a href="/products/corealign-compression-vest">CoreAlign Compression Vest</a></h3>
            <div class="product-card-price"><span class="product-price-current">$34.99</span><span class="product-price-compare">$44.99</span></div>
          </div>
        </div>

