{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/preview/index.html" },
    { "source": "/index", "destination": "/preview/index.html" },
    { "source": "/index.html", "destination": "/preview/index.html" },
    { "source": "/shop", "destination": "/preview/collection.html" },
    { "source": "/collection", "destination": "/preview/collection.html" },
    { "source": "/collections", "destination": "/preview/collection.html" },
    { "source": "/product", "destination": "/preview/product.html" },
    { "source": "/products", "destination": "/preview/collection.html" },
    { "source": "/cart", "destination": "/preview/cart.html" },
    { "source": "/bag", "destination": "/preview/cart.html" },
    { "source": "/about", "destination": "/preview/about.html" },
    { "source": "/contact", "destination": "/preview/contact.html" },
    { "source": "/account", "destination": "/preview/account.html" },
    { "source": "/orders", "destination": "/preview/account.html" },
    { "source": "/shapewear", "destination": "/preview/shapewear.html" },
    { "source": "/shipping", "destination": "/preview/shipping.html" },
    { "source": "/returns", "destination": "/preview/returns.html" },
    { "source": "/privacy", "destination": "/preview/privacy.html" },
    { "source": "/terms", "destination": "/preview/terms.html" },
    { "source": "/preview/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/:page.html", "destination": "/preview/:page.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
